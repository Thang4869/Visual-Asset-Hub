# ============================================================
# VAH — Environment Variables
# Copy to .env and fill in real values before running Docker Compose.
# NEVER commit .env to source control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=vah
POSTGRES_USER=vah
POSTGRES_PASSWORD=change_me_strong_password

# --- JWT ---
# Must be at least 32 characters
JWT_SECRET_KEY=change_me_min_32_chars_random_secret_here

# --- Frontend ---
# Public URL of the backend API, reachable from the browser
VITE_API_URL=https://yourdomain.com/api/v1
